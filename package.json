{
  "name": "arc-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A living onchain companion shaped by your Arc history and daily activity.",
  "license": "MIT",
  "scripts": {
    "predev": "npm run verify:art",
    "dev": "next dev",
    "prebuild": "npm run verify:art",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:vexa-art": "node scripts/verify-vexa-art.cjs",
    "verify:koru-art": "node scripts/verify-koru-art.cjs",
    "verify:advanced-art": "node scripts/verify-advanced-art.cjs",
    "verify:art": "npm run verify:vexa-art && npm run verify:koru-art && npm run verify:advanced-art",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "test": "npm run contracts:test",
    "ci": "npm run verify:art && npm run contracts:compile && npm run contracts:test && npm run typecheck && npm run build",
    "preflight:arc": "hardhat run scripts/preflight.cjs --network arcTestnet",
    "deploy:arc": "hardhat run scripts/deploy.cjs --network arcTestnet"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "1.17.1",
    "@circle-fin/app-kit": "1.14.0",
    "@openzeppelin/contracts": "5.6.1",
    "next": "15.5.20",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "viem": "2.55.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "ethers": "6.15.0",
    "hardhat": "2.28.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
